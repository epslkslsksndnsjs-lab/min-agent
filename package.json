{
  "name": "min-agent",
  "version": "0.1.0",
  "description": "min-cli — a TypeScript coding assistant with OpenAI-compatible streaming tool-calling.",
  "license": "MIT",
  "keywords": [
    "cli",
    "coding-assistant",
    "agent-loop",
    "llm",
    "tool-calling",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "min-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "smoke": "npm run build && node scripts/tui-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "execa": "^10.0.1",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.9",
    "zod": "^4.4.3"
  }
}
